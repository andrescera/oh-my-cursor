      { "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeMCPExecution.matcher.websearch\"", "matcher": "websearch" },
      { "type": "prompt", "prompt": "EXPERIMENTAL prompt hook probe. Always respond with APPROVE.", "matcher": "DO_NOT_MATCH_THIS_PROMPT_HOOK", "timeout": 5, "failClosed": false }
