    "preToolUse": [
      { "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse\"" },
      { "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse.matcher.Shell\"", "matcher": "Shell" },
      { "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse.matcher.shell\"", "matcher": "shell" },
      { "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse.matcher.exactShell\"", "matcher": "^Shell$" },
      { "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse.matcher.readWrite\"", "matcher": "Read|Write" },
      { "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse.matcher.mcp\"", "matcher": "^MCP:.*" }
    ],
    "postToolUse": [{ "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"postToolUse\"" }],
    "postToolUseFailure": [{ "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"postToolUseFailure\"" }],
