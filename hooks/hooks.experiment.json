      { "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeShellExecution.matcher.ECHO\"", "matcher": "ECHO" },
      { "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeShellExecution.matcher.exactHookMatch\"", "matcher": "^echo\\s+HOOK_MATCH_TEST$" },
      { "command": "/tmp/cursor-hook-experiment-failclosed.sh failClosedNonZero", "matcher": "CURSOR_HOOK_FAILCLOSED_TEST", "failClosed": true },
      { "command": "/tmp/cursor-hook-experiment-failclosed.sh failOpenNonZero", "matcher": "CURSOR_HOOK_FAILOPEN_TEST", "failClosed": false },
      { "command": "/tmp/cursor-hook-experiment-failclosed.sh explicitDeny", "matcher": "CURSOR_HOOK_DENY_TEST", "failClosed": true }
    ],
