{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"sessionStart\""
      }
    ],
    "sessionEnd": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"sessionEnd\""
      }
    ],
    "preToolUse": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse\""
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse.matcher.Shell\"",
        "matcher": "Shell"
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse.matcher.shell\"",
        "matcher": "shell"
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse.matcher.exactShell\"",
        "matcher": "^Shell$"
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse.matcher.readWrite\"",
        "matcher": "Read|Write"
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preToolUse.matcher.mcp\"",
        "matcher": "^MCP:.*"
      }
    ],
    "postToolUse": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"postToolUse\""
      }
    ],
    "postToolUseFailure": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"postToolUseFailure\""
      }
    ],
    "subagentStart": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"subagentStart\""
      }
    ],
    "subagentStop": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"subagentStop\""
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"subagentStop.loopLimit1\"",
        "loop_limit": 1
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"subagentStop.loopLimitNull\"",
        "loop_limit": null
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeShellExecution\""
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeShellExecution.matcher.echo\"",
        "matcher": "echo"
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeShellExecution.matcher.ECHO\"",
        "matcher": "ECHO"
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeShellExecution.matcher.exactHookMatch\"",
        "matcher": "^echo\\s+HOOK_MATCH_TEST$"
      },
      {
        "command": "/tmp/cursor-hook-experiment-failclosed.sh failClosedNonZero",
        "matcher": "CURSOR_HOOK_FAILCLOSED_TEST",
        "failClosed": true
      },
      {
        "command": "/tmp/cursor-hook-experiment-failclosed.sh failOpenNonZero",
        "matcher": "CURSOR_HOOK_FAILOPEN_TEST",
        "failClosed": false
      },
      {
        "command": "/tmp/cursor-hook-experiment-failclosed.sh explicitDeny",
        "matcher": "CURSOR_HOOK_DENY_TEST",
        "failClosed": true
      }
    ],
    "afterShellExecution": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"afterShellExecution\""
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeMCPExecution\""
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeMCPExecution.matcher.websearch\"",
        "matcher": "websearch"
      },
      {
        "type": "prompt",
        "prompt": "EXPERIMENTAL prompt hook probe. Always respond with APPROVE always.",
        "matcher": "DO_NOT_MATCH_THIS_PROMPT_HOOK",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "afterMCPExecution": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"afterMCPExecution\""
      }
    ],
    "beforeReadFile": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeReadFile\""
      }
    ],
    "afterFileEdit": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"afterFileEdit\""
      }
    ],
    "afterAgentResponse": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"afterAgentResponse\""
      }
    ],
    "afterAgentThought": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"afterAgentThought\""
      }
    ],
    "preCompact": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"preCompact\""
      }
    ],
    "stop": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"stop\""
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"stop.loopLimit1\"",
        "loop_limit": 1
      },
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"stop.loopLimitNull\"",
        "loop_limit": null
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeSubmitPrompt\""
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"beforeTabFileRead\""
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "bash \"<REPO>/hooks/scripts/experiment-logger.sh\" \"afterTabFileEdit\""
      }
    ]
  }
}
